NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SERPAPI_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6

# Optional: vision/OCR model for images and scanned PDFs
OPENAI_OCR_MODEL=

# Transactional email provider: resend | smtp
EMAIL_PROVIDER=smtp

# Resend (optional)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Common
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=
CRON_SECRET=

# SMTP - your own domain mailbox/server
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# IMAP - same mailbox (used for inbound supplier/customer email polling)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
